{
  "name": "doom-daw-irken-audio-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/check-node.js && next dev",
    "dev:full": "next dev",
    "dev:preview": "npm run build && npm run preview",
    "build": "node scripts/check-node.js && next build",
    "build:nvm": "bash scripts/build-with-nvm.sh build",
    "build:raw": "next build",
    "preview": "node scripts/check-node.js && next start",
    "preview:nvm": "bash scripts/build-with-nvm.sh preview",
    "test": "node scripts/check-node.js && vitest run",
    "test:watch": "node scripts/check-node.js && vitest",
    "test:coverage": "node scripts/check-node.js && vitest run --coverage",
    "test:e2e": "node scripts/check-node.js && vitest run e2e/",
    "test:e2e:browser": "node scripts/check-node.js && playwright test",
    "test:comfyui": "node scripts/check-node.js && npx tsx scripts/test-comfyui-audio.ts",
    "validate:blueprint": "node scripts/validate-blueprint.mjs",
    "validate:blueprint:coverage": "node scripts/validate-blueprint.mjs --coverage",
    "start:all": "pnpm run validate:blueprint && pnpm run dev"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.170",
    "@clerk/nextjs": "^7.2.7",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.168",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "i": "^0.3.7",
    "lucide-react": "^0.577.0",
    "next": "^16.2.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "replicate": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.7.11",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
