# Copy to .env.local and fill in your tokens. Do not commit .env.local.

# Optional: AI song structure (OpenRouter — e.g. Gemini). Unused if you only use Generate audio.
# Get a key: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=

# Generate (text-to-audio) — Stability AI Stable Audio 2.5 via Replicate (required):

# Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Dev only — do NOT set in Vercel or any production environment:
# VITE_AUDIO_MOCK, VITE_SIMULATE_AUDIO (app will fail in production if set)
