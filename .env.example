# Copy to .env.local and fill in your tokens. Do not commit .env.local.

# Optional: AI song structure via /api/generate-song (OpenRouter — e.g. Gemini).
# SERVER-SIDE ONLY: set in Vercel env vars / .env.local. Never exposed to the client bundle.
# Get a key: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=

# Generate (text-to-audio) — Replicate only (Stability AI Stable Audio 2.5):

# Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Token: https://huggingface.co/settings/tokens  (Inference API access required)
# Used for: the HF Creative Engine (text + image generation via /api/hf-generate)
HUGGINGFACE_API_TOKEN=

# Dev only — do NOT set in Vercel or any production environment:
# VITE_AUDIO_MOCK, VITE_SIMULATE_AUDIO (app will fail in production if set)
