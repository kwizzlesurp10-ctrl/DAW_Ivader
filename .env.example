# Required for AI song structure (optional; unused if you only use Generate audio).
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for Generate (text-to-audio). Get a token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Dev only — do NOT set in Vercel or any production environment:
# VITE_AUDIO_MOCK, VITE_SIMULATE_AUDIO (app will fail in production if set)
