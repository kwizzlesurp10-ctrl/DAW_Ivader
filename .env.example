# Copy to .env.local and fill in your tokens. Do not commit .env.local.

# Optional: AI song structure (OpenRouter — e.g. Gemini). Unused if you only use Generate audio.
# Get a key: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=

# Generate (text-to-audio) — set ONE of the following (HuggingFace recommended):

# HuggingFace Inference API (recommended). Meta MusicGen (facebook/musicgen-*).
# Token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# Option B: Replicate (fallback). Used only when HUGGINGFACE_API_TOKEN is not set.
# Get a token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Dev only — do NOT set in Vercel or any production environment:
# VITE_AUDIO_MOCK, VITE_SIMULATE_AUDIO (app will fail in production if set)
