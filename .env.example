# Required for AI song structure (optional; unused if you only use Generate audio).
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generate (text-to-audio) — set ONE of the following backends (HuggingFace is recommended):

# Option A: HuggingFace Inference API (recommended).
# Get a token: https://huggingface.co/settings/tokens
# Uses Meta MusicGen models (facebook/musicgen-*) directly from HuggingFace.
HUGGINGFACE_API_TOKEN=

# Option B: Replicate (fallback). Used only when HUGGINGFACE_API_TOKEN is not set.
# Get a token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Dev only — do NOT set in Vercel or any production environment:
# VITE_AUDIO_MOCK, VITE_SIMULATE_AUDIO (app will fail in production if set)
