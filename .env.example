# Copy to .env or .env.local and fill in your tokens. Do not commit .env or .env.local.
# If any env file with real tokens was ever committed to git, rotate those keys immediately.

# Auth (Clerk)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI chat (Vercel AI Gateway)
AI_GATEWAY_API_KEY=

# Optional: AI song structure (OpenRouter - e.g. Gemini). Unused if you only use Generate audio.
# Get a key: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=

# Generate (text-to-audio) - Stability AI Stable Audio 2.5 via Replicate (required):

# Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional local Generate backend - ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_AUDIO_WORKFLOW_PATH=workflows/comfy-audio-api.json
# Set these when automatic prompt injection cannot find the right workflow input:
# COMFYUI_PROMPT_NODE_ID=
# COMFYUI_PROMPT_INPUT_KEY=text
# COMFYUI_NEGATIVE_PROMPT_NODE_ID=
# COMFYUI_NEGATIVE_PROMPT_INPUT_KEY=text
# COMFYUI_POLL_INTERVAL_MS=1000
# COMFYUI_POLL_ATTEMPTS=90

# Dev only — do NOT set in Vercel or any production environment:
# NEXT_PUBLIC_AUDIO_MOCK, NEXT_PUBLIC_SIMULATE_AUDIO (app will fail in production if set)
